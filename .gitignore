# Python の環境（setup.sh で作り直す）
.venv/
__pycache__/

# 案件のデータ（素材・生成物）はソフトのリポジトリに入れない
projects/

# クローンした声のサンプルと許諾の記録（人の声のデータなので入れない）
voices/

# 生成物（正本の JSON から作り直せる）
**/_tmp/
**/narration/
test/work/shorts/*/
test/ivwork/shorts/*/
